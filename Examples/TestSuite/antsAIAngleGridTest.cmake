# The antsAI rotation search must include the initial rotation (angle 0). The
# grid used to start at -180 * arcFraction degrees, so -s [20,0.12] tried
# -21.6, -1.6 and 18.4 degrees, and never 0. The test aligns an image to
# itself with a learning rate of 1e-6, so the result is the best start, and
# checks that it is the identity, in 2D and 3D. The images are made here, so
# the test needs no data files.
file(MAKE_DIRECTORY "${TEST_OUTPUT_DIR}")

function(run)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=1 ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Command failed (${result}): ${ARGN}\n${stdout}\n${stderr}")
  endif()
  set(stdout "${stdout}" PARENT_SCOPE)
endfunction()

# An asymmetric object: a ramp in an L shape, so that any rotation changes the image.
function(write_image file ndims)
  if(ndims EQUAL 2)
    set(nz 1)
  else()
    set(nz 12)
  endif()
  set(values "")
  math(EXPR zlast "${nz} - 1")
  foreach(z RANGE ${zlast})
    foreach(y RANGE 23)
      foreach(x RANGE 23)
        set(value 0)
        if(x GREATER_EQUAL 4 AND x LESS_EQUAL 19 AND y GREATER_EQUAL 4 AND y LESS_EQUAL 8)
          math(EXPR value "20 + 3 * ${x} + ${y} + ${z}")
        elseif(x GREATER_EQUAL 4 AND x LESS_EQUAL 8 AND y GREATER_EQUAL 9 AND y LESS_EQUAL 19)
          math(EXPR value "60 + 2 * ${y} + ${z}")
        endif()
        if(ndims EQUAL 3 AND (z LESS 2 OR z GREATER 9))
          set(value 0)
        endif()
        string(APPEND values "${value} ")
      endforeach()
    endforeach()
  endforeach()
  if(ndims EQUAL 2)
    set(header "NDims = 2\nElementSpacing = 1 1\nOffset = 40 -25\nDimSize = 24 24\n")
  else()
    set(header "NDims = 3\nElementSpacing = 1 1 1\nOffset = 40 -25 60\nDimSize = 24 24 12\n")
  endif()
  file(WRITE "${file}" "ObjectType = Image\n${header}ElementType = MET_FLOAT\nBinaryData = False\n"
    "ElementDataFile = LOCAL\n${values}\n")
endfunction()

set(number "([-+0-9.eE]+|-?nan|-?inf)")

foreach(ndims 2 3)
  set(image "${TEST_OUTPUT_DIR}/image${ndims}d.mha")
  write_image("${image}" ${ndims})
  foreach(search "[20,0.12]" "[30,0.5]")
    set(output "${TEST_OUTPUT_DIR}/self_${ndims}d.mat")
    run("${ANTS_AI}" -d ${ndims} -m "Mattes[${image},${image},32,None]" -t "Rigid[1e-6]" -s "${search}" -c 1
      -o "${output}")
    run("${ANTS_TRANSFORM_INFO}" "${output}")
    if(ndims EQUAL 2)
      set(pattern "Matrix \\(2x2\\)[ \n]+${number} ${number} *\n *${number} ${number}")
    else()
      set(pattern "Matrix \\(3x3\\)[ \n]+${number} ${number} ${number} *\n *${number} ${number} ${number} *\n *${number} ${number} ${number}")
    endif()
    if(NOT stdout MATCHES "${pattern}")
      message(FATAL_ERROR "Cannot read the matrix from:\n${stdout}")
    endif()
    set(matrix "")
    foreach(i RANGE 1 ${CMAKE_MATCH_COUNT})
      list(APPEND matrix "${CMAKE_MATCH_${i}}")
    endforeach()
    # Off-diagonal entries are sin(angle): 0.001 allows 0.06 degrees; the old
    # grid's nearest start, -1.6 degrees, gives 0.028.
    foreach(i RANGE 1 ${CMAKE_MATCH_COUNT})
      math(EXPR k "${i} - 1")
      list(GET matrix ${k} value)
      if(NOT value MATCHES "^[-+0-9.eE]+$")
        message(FATAL_ERROR "${ndims}D -s ${search}: the matrix is not finite: ${matrix}")
      endif()
      math(EXPR row "${k} / ${ndims}")
      math(EXPR column "${k} % ${ndims}")
      if(row EQUAL column)
        if(value LESS 0.999)
          message(FATAL_ERROR "${ndims}D -s ${search}: aligning an image to itself is not the identity: ${matrix}")
        endif()
      elseif(value GREATER 0.001 OR value LESS -0.001)
        message(FATAL_ERROR "${ndims}D -s ${search}: aligning an image to itself is not the identity: ${matrix}")
      endif()
    endforeach()
  endforeach()
endforeach()
