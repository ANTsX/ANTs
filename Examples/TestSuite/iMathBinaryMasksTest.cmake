# Test the operations with binary masks; shared-reader normalization is covered
# by antsReadBinaryMaskTest.
file(MAKE_DIRECTORY "${TEST_OUTPUT_DIR}")

function(run_checked)
  execute_process(COMMAND ${ARGV} RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT result EQUAL 0)
    message(FATAL_ERROR "Command failed: ${ARGV}\n${output}\n${error}")
  endif()
endfunction()

function(write_fixture name dimension sizes values)
  set(file "${TEST_OUTPUT_DIR}/${name}.mha")
  file(WRITE "${file}"
    "ObjectType = Image\nNDims = ${dimension}\nBinaryData = False\nDimSize = ${sizes}\nElementType = MET_FLOAT\nElementDataFile = LOCAL\n${values}\n")
  run_checked("${IMAGE_CHECK}" --write-fixture "${dimension}" "${file}")
endfunction()

foreach(dimension RANGE 2 4)
  set(sizes "")
  set(distance_sizes "6")
  set(count 1)
  set(component_size 1)
  foreach(axis RANGE 1 ${dimension})
    string(APPEND sizes "6 ")
    math(EXPR count "${count} * 6")
    math(EXPR component_size "${component_size} * 4")
    if(axis GREATER 1)
      string(APPEND distance_sizes " 1")
    endif()
  endforeach()
  math(EXPR last "${count} - 1")
  set(component_values "")
  set(shell_values "")
  set(cube_values "")
  foreach(index RANGE 0 ${last})
    set(remaining ${index})
    set(inside TRUE)
    set(hole TRUE)
    foreach(axis RANGE 1 ${dimension})
      math(EXPR coordinate "${remaining} % 6")
      math(EXPR remaining "${remaining} / 6")
      if(coordinate EQUAL 0 OR coordinate EQUAL 5)
        set(inside FALSE)
      endif()
      if(NOT coordinate EQUAL 2)
        set(hole FALSE)
      endif()
    endforeach()
    set(cube 0)
    set(shell 0)
    set(component 0)
    if(inside)
      set(cube 1)
      set(shell 1)
      set(component 1)
    endif()
    if(hole)
      set(shell 0)
    endif()
    if(index EQUAL 0)
      set(component 1) # A separate singleton must not survive largest-component selection.
    endif()
    string(APPEND component_values "${component} ")
    string(APPEND shell_values "${shell} ")
    string(APPEND cube_values "${cube} ")
  endforeach()
  foreach(name component shell cube)
    write_fixture("${name}${dimension}" "${dimension}" "${sizes}" "${${name}_values}")
  endforeach()
  set(output "${TEST_OUTPUT_DIR}/output${dimension}.mha")
  run_checked("${IMATH}" "${dimension}" "${output}" GetLargestComponent
    "${TEST_OUTPUT_DIR}/component${dimension}.mha" 1)
  run_checked("${IMAGE_CHECK}" "${dimension}" "${output}" "${TEST_OUTPUT_DIR}/cube${dimension}.mha" 0)
  run_checked("${IMATH}" "${dimension}" "${output}" GetLargestComponent
    "${TEST_OUTPUT_DIR}/component${dimension}.mha" "${component_size}")
  run_checked("${IMAGE_CHECK}" "${dimension}" "${output}" "${TEST_OUTPUT_DIR}/cube${dimension}.mha" 0)
  run_checked("${IMATH}" "${dimension}" "${output}" FillHoles "${TEST_OUTPUT_DIR}/shell${dimension}.mha")
  run_checked("${IMAGE_CHECK}" "${dimension}" "${output}" "${TEST_OUTPUT_DIR}/cube${dimension}.mha" 0)

  # A single foreground voxel at index 2: exact distances along one axis.
  write_fixture("point${dimension}" "${dimension}" "${distance_sizes}" "0 0 1 0 0 0")
  write_fixture("distance${dimension}" "${dimension}" "${distance_sizes}" "2 1 0 1 2 3")
  run_checked("${IMATH}" "${dimension}" "${output}" DistanceMap "${TEST_OUTPUT_DIR}/point${dimension}.mha")
  run_checked("${IMAGE_CHECK}" "${dimension}" "${output}" "${TEST_OUTPUT_DIR}/distance${dimension}.mha" 0.0001)
endforeach()
