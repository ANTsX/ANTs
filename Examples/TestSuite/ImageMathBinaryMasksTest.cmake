# Method-level correctness checks. Mask binarization is tested separately by
# antsReadBinaryMaskTest; every mask in this test contains only zero and one.
file(MAKE_DIRECTORY "${TEST_OUTPUT_DIR}")
foreach(name input other linear base mask normalized mtr masked_input masked_other tensor masked_tensor color
    vector matrix_rows matrix_columns shell largest cluster cluster_mask cluster_expected metric independent)
  set(${name}_values "")
endforeach()
foreach(i RANGE 0 215)
  math(EXPR x "${i} % 6")
  math(EXPR y "(${i} / 6) % 6")
  math(EXPR z "${i} / 36")
  math(EXPR parity "${x} % 2")
  math(EXPR independent_parity "${y} % 2")
  set(inside FALSE)
  if(x GREATER 0 AND x LESS 5 AND y GREATER 0 AND y LESS 5 AND z GREATER 0 AND z LESS 5)
    set(inside TRUE)
  endif()
  set(value 1000)
  set(other 0)
  set(metric 10)
  set(independent 10)
  set(mask 0)
  set(normalized 50)
  set(mtr 0)
  set(masked_input 0)
  set(masked_other 0)
  set(masked_tensor "0 0 0 0 0 0")
  set(color "0 0 0")
  if(inside)
    set(mask 1)
    if(parity)
      set(value 30)
      set(normalized 1.5)
      set(mtr 0.25)
    else()
      set(value 10)
      set(normalized 0.5)
      set(mtr 0.75)
    endif()
    math(EXPR other "2 * ${value} + 30")
    set(metric ${value})
    if(independent_parity)
      set(independent 30)
    endif()
    set(masked_input ${value})
    set(masked_other ${other})
    set(masked_tensor "1.5 0.5 0 1.5 0 1")
    # Eigenvalues (2,1,1), principal direction (1,1,0)/sqrt(2):
    # FA = sqrt(1/6), so the RGB components are floor(255/sqrt(12)).
    set(color "73 73 0")
    string(APPEND vector_values "${value} ")
    string(APPEND matrix_columns_values "${value} ${other} ")
  endif()
  math(EXPR linear "2 * ${value} + 30")
  set(base 40)
  set(tensor "1.5 0.5 0 1.5 0 1")
  set(shell ${mask})
  if(x EQUAL 2 AND y EQUAL 2 AND z EQUAL 2)
    set(shell 0)
  endif()
  set(largest ${mask})
  if(i EQUAL 0)
    set(largest 1)
  endif()
  set(cluster 0)
  set(cluster_mask 0)
  set(cluster_expected 0)
  if(x GREATER 0 AND x LESS 4 AND y EQUAL 2 AND z EQUAL 2)
    set(cluster 4)
    set(cluster_mask 1)
    set(cluster_expected 4)
  elseif(i EQUAL 215)
    set(cluster 9)
    set(cluster_mask 1)
  elseif(i EQUAL 0)
    # A singleton outside the mask must be retained.
    set(cluster 8)
    set(cluster_expected 8)
  endif()
  foreach(name input other linear base mask normalized mtr masked_input masked_other tensor masked_tensor color
      shell largest cluster cluster_mask cluster_expected metric independent)
    if(name STREQUAL "input")
      string(APPEND input_values "${value} ")
    else()
      string(APPEND ${name}_values "${${name}} ")
    endif()
  endforeach()
endforeach()
# Image-set rows contain each image's selected values in voxel order.
set(matrix_rows_values "${vector_values}")
foreach(i RANGE 0 63)
  math(EXPR x "${i} % 4")
  math(EXPR parity "${x} % 2")
  if(parity)
    string(APPEND matrix_rows_values "50 ")
  else()
    string(APPEND matrix_rows_values "90 ")
  endif()
endforeach()

function(write_image name dimensions size components values)
  file(WRITE "${TEST_OUTPUT_DIR}/${name}.mha"
    "ObjectType = Image\nNDims = ${dimensions}\nBinaryData = False\nDimSize = ${size}\nElementNumberOfChannels = ${components}\nElementType = MET_FLOAT\nElementDataFile = LOCAL\n${values}\n")
  execute_process(COMMAND "${IMAGE_CHECK}" --write-fixture ${dimensions} "${TEST_OUTPUT_DIR}/${name}.mha"
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "Cannot write ${name} fixture: ${stdout}\n${stderr}")
  endif()
endfunction()
foreach(name input other linear base mask normalized mtr masked_input masked_other shell largest
    cluster cluster_mask cluster_expected metric independent)
  write_image(${name} 3 "6 6 6" 1 "${${name}_values}")
endforeach()
write_image(tensor 3 "6 6 6" 6 "${tensor_values}")
write_image(masked_tensor 3 "6 6 6" 6 "${masked_tensor_values}")
write_image(color 3 "6 6 6" 3 "${color_values}")
write_image(timeseries 4 "6 6 6 2" 1 "${input_values} ${other_values}")
write_image(masked_timeseries 4 "6 6 6 2" 1 "${masked_input_values} ${masked_other_values}")
write_image(vector 2 "64 1" 1 "${vector_values}")
write_image(matrix_rows 2 "64 2" 1 "${matrix_rows_values}")
write_image(matrix_columns 2 "2 64" 1 "${matrix_columns_values}")
write_image(distance_input 3 "6 1 1" 1 "0 0 1 0 0 0")
write_image(distance_expected 3 "6 1 1" 1 "2 1 0 1 2 3")
# Truncation at quantiles 0 and 1 must clip the whole image to the masked
# intensity range [10,30], including the excluded 1000-valued background.
string(REGEX REPLACE "1000 " "30 " truncated_values "${input_values}")
write_image(truncated 3 "6 6 6" 1 "${truncated_values}")

function(run name dimension operation extension)
  set(output "${TEST_OUTPUT_DIR}/result-${name}.${extension}")
  execute_process(
    COMMAND "${CMAKE_COMMAND}" -E env ITK_GLOBAL_DEFAULT_NUMBER_OF_THREADS=2
      "${IMAGE_MATH}" ${dimension} "${output}" ${operation} ${ARGN}
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${name} failed: ${stdout}\n${stderr}")
  endif()
  set(last_stdout "${stdout}" PARENT_SCOPE)
  set(last_output "${output}" PARENT_SCOPE)
endfunction()

function(check_image dimension expected)
  execute_process(COMMAND "${IMAGE_CHECK}" ${dimension} "${last_output}"
      "${TEST_OUTPUT_DIR}/${expected}.mha" 0.0001
    RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT "${result}" STREQUAL "0")
    message(FATAL_ERROR "${last_output}: ${stdout}\n${stderr}")
  endif()
endfunction()

function(check_metric lower upper)
  string(STRIP "${last_stdout}" value)
  if(NOT value MATCHES "^-?[0-9]+([.][0-9]+)?([eE][-+]?[0-9]+)?$")
    message(FATAL_ERROR "Invalid metric: ${last_stdout}")
  endif()
  if(value LESS lower OR value GREATER upper)
    message(FATAL_ERROR "Expected metric in [${lower},${upper}], got ${value}")
  endif()
endfunction()

set(input "${TEST_OUTPUT_DIR}/input.mha")
set(other "${TEST_OUTPUT_DIR}/other.mha")
set(mask "${TEST_OUTPUT_DIR}/mask.mha")
run(cluster 3 ClusterThresholdVariate mha "${TEST_OUTPUT_DIR}/cluster.mha" "${TEST_OUTPUT_DIR}/cluster_mask.mha" 1)
check_image(3 cluster_expected)
run(truncate 3 TruncateImageIntensity mha "${input}" 0 1 64 "${mask}")
check_image(3 truncated)
run(vector-image 3 ConvertVectorToImage mha "${mask}" "${TEST_OUTPUT_DIR}/vector.mha")
check_image(3 masked_input)
run(time-mask 4 TimeSeriesMask mha "${TEST_OUTPUT_DIR}/timeseries.mha" "${mask}")
check_image(4 masked_timeseries)
run(time-matrix 4 TimeSeriesToMatrix mha "${TEST_OUTPUT_DIR}/timeseries.mha" "${mask}")
check_image(2 matrix_columns)
run(mtr 3 MTR mha "${TEST_OUTPUT_DIR}/base.mha" "${input}" "${mask}")
check_image(3 mtr)
run(normalize 3 Normalize mha "${input}" "${mask}")
check_image(3 normalized)
run(difference 3 CountVoxelDifference txt "${input}" "${other}" "${mask}")
file(READ "${last_output}" difference)
if(NOT difference MATCHES "Err +: 3200 +%ER +: 5000 +NER +: -5000")
  message(FATAL_ERROR "Unexpected masked differences: ${difference}")
endif()
foreach(layout RANGE 0 1)
  run(image-matrix-${layout} 3 ConvertImageSetToMatrix mha ${layout} "${mask}" "${input}" "${other}")
  if(layout EQUAL 0)
    check_image(2 matrix_rows)
  else()
    check_image(2 matrix_columns)
  endif()
endforeach()
run(image-file 3 ConvertImageToFile txt "${input}" "${mask}")
file(READ "${last_output}" actual_values)
string(REGEX REPLACE "[ \n\r]+" ";" actual_values "${actual_values}")
string(REGEX REPLACE "^;|;$" "" actual_values "${actual_values}")
string(STRIP "${vector_values}" expected_values)
string(REPLACE " " ";" expected_values "${expected_values}")
if(NOT actual_values STREQUAL expected_values)
  message(FATAL_ERROR "Masked values were not extracted in voxel order")
endif()
run(pearson 3 PearsonCorrelation unused "${input}" "${other}" "${mask}")
check_metric(0.99999 1.00001)
run(neighborhood 3 NeighborhoodCorrelation unused "${input}" "${TEST_OUTPUT_DIR}/linear.mha" 1 "${mask}")
check_metric(-1.00001 -0.99999)
run(correlation 3 NormalizedCorrelation unused "${input}" "${other}" "${mask}")
check_metric(-1.00001 -0.99999)
run(mattes-independent 3 Mattes unused "${TEST_OUTPUT_DIR}/metric.mha" "${TEST_OUTPUT_DIR}/independent.mha" 16 "${mask}")
check_metric(-0.00001 0.00001)
run(mattes-identical 3 Mattes unused "${TEST_OUTPUT_DIR}/metric.mha" "${TEST_OUTPUT_DIR}/metric.mha" 16 "${mask}")
check_metric(-0.69316 -0.69313)
run(tensor-mask 3 TensorMask mha "${TEST_OUTPUT_DIR}/tensor.mha" "${mask}")
check_image(3 masked_tensor)
run(tensor-color 3 TensorColor mha "${TEST_OUTPUT_DIR}/tensor.mha" "${mask}")
check_image(3 color)
run(largest 3 GetLargestComponent mha "${TEST_OUTPUT_DIR}/largest.mha" 1)
check_image(3 mask)
run(holes 3 FillHoles mha "${TEST_OUTPUT_DIR}/shell.mha" 2)
check_image(3 mask)
run(distance 3 D mha "${TEST_OUTPUT_DIR}/distance_input.mha")
check_image(3 distance_expected)
